[Unit]
Description=DDC/CI monitor ambient light sensor (net.hadess.SensorProxy)
Conflicts=iio-sensor-proxy.service

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/usr/bin/ddc-sensor-proxy --model U4025QW
Restart=on-failure
RestartSec=5
# Let the kernel batch our timer wakeups with others.
TimerSlackNSec=50ms

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-i2c rw
CapabilityBoundingSet=
# AF_NETLINK for DRM hotplug uevents.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=graphical.target
